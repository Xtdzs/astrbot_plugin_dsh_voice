{
  "speech": {
    "description": "说话 API 与音色（发送形式由模型自主选择）",
    "type": "object",
    "items": {
      "provider": {
        "description": "语音 API",
        "type": "string",
        "default": "minimax",
        "options": [
          "minimax",
          "qwen"
        ]
      },
      "speed": {
        "description": "手动朗读默认语速（MiniMax）",
        "type": "float",
        "default": 1.0,
        "hint": "用于 /说话；模型调用 voice_speak 时自行选择 0.85–1.2 的本次语速，默认 1.0。"
      },
      "max_characters": {
        "description": "每段语音最大字符数",
        "type": "int",
        "default": 500,
        "hint": "较长回复按自然停顿分成多段语音，不发送重复文字。千问每段最多 600 字。"
      },
      "max_reply_characters": {
        "description": "单次语音内容总字数上限",
        "type": "int",
        "default": 2000,
        "hint": "超出时工具返回失败，由现有模型用文字回答；不截断内容。"
      }
    }
  },
  "minimax": {
    "description": "MiniMax 语音 API",
    "type": "object",
    "items": {
      "api_key": {
        "description": "MiniMax API Key",
        "type": "string",
        "secret": true,
        "default": "",
        "hint": "也可设置 MINIMAX_API_KEY；需有语音接口权限和余额。"
      },
      "base_url": {
        "description": "接口地址",
        "type": "string",
        "default": "https://api.minimax.cn",
        "hint": "可按账户地域修改，例如 api.minimaxi.com 或国际站地址。不要填写网页地址。"
      },
      "speech_model": {
        "description": "语音模型",
        "type": "string",
        "default": "speech-2.8-turbo"
      },
      "voice_id": {
        "description": "TTS 音色 ID",
        "type": "string",
        "default": "lovely_girl",
        "hint": "默认萌萌女童。也可填账户创建的克隆音色 ID。"
      }
    }
  },
  "qwen": {
    "description": "千问语音 API",
    "type": "object",
    "items": {
      "api_key": {
        "description": "百炼 API Key",
        "type": "string",
        "secret": true,
        "default": "",
        "hint": "也可设置 DASHSCOPE_API_KEY。"
      },
      "base_url": {
        "description": "DashScope API 根地址",
        "type": "string",
        "default": "https://dashscope.aliyuncs.com/api/v1",
        "hint": "新加坡账户使用 https://dashscope-intl.aliyuncs.com/api/v1，Key 必须匹配地域。"
      },
      "model": {
        "description": "非实时 TTS 模型",
        "type": "string",
        "default": "qwen3-tts-flash"
      },
      "voice": {
        "description": "千问音色",
        "type": "string",
        "default": "Cherry"
      }
    }
  },
  "limits": {
    "description": "调用与缓存设置",
    "type": "object",
    "items": {
      "allowed_users": {
        "description": "允许使用的 QQ 号（空表示不限）",
        "type": "list",
        "default": []
      },
      "max_concurrent": {
        "description": "同时处理的任务上限",
        "type": "int",
        "default": 2
      },
      "cooldown_seconds": {
        "description": "每位用户的调用间隔秒数",
        "type": "int",
        "default": 1
      },
      "max_audio_mb": {
        "description": "下载音频大小上限 MB",
        "type": "int",
        "default": 40
      },
      "retention_hours": {
        "description": "音频缓存保留小时数",
        "type": "int",
        "default": 24
      }
    }
  }
}
