{
  "reply_mode": {
    "description": "回复方式：语音或文字",
    "type": "string",
    "default": "voice",
    "options": [
      "voice",
      "text"
    ],
    "labels": [
      "只发语音",
      "只发文字"
    ],
    "hint": "语音成功时不发送同内容文字；转换失败或内容无法朗读时保留原文字。QQ 中可用 /voice 语音 或 /voice 文字 覆盖自己的模式。"
  },
  "speech": {
    "description": "说话设置",
    "type": "object",
    "items": {
      "provider": {
        "description": "语音 API",
        "type": "string",
        "default": "minimax",
        "options": [
          "minimax",
          "qwen"
        ]
      },
      "character_conversion": {
        "description": "说话也经 RVC 转成固定角色音色",
        "type": "bool",
        "default": false,
        "hint": "需要配置 Replicate Key 和角色模型。会增加每次说话的费用和延迟。先单独测试翻唱。"
      },
      "speed": {
        "description": "MiniMax 朗读速度",
        "type": "float",
        "default": 1.0
      },
      "max_characters": {
        "description": "每段语音最大字符数",
        "type": "int",
        "default": 500,
        "hint": "较长回复按自然停顿分成多段语音，不发送重复文字。千问每段最多 600 字。"
      },
      "max_reply_characters": {
        "description": "单条回复的自动朗读总字数上限",
        "type": "int",
        "default": 2000,
        "hint": "超过上限时保留完整文字，避免自动生成过多付费语音。不会截断原回复。"
      }
    }
  },
  "minimax": {
    "description": "MiniMax 语音及歌曲 API",
    "type": "object",
    "items": {
      "api_key": {
        "description": "MiniMax API Key",
        "type": "string",
        "secret": true,
        "default": "",
        "hint": "也可设置 MINIMAX_API_KEY；语音或音乐需对应账户权限。"
      },
      "base_url": {
        "description": "接口地址",
        "type": "string",
        "default": "https://api.minimax.cn",
        "hint": "可按账户地域修改，例如 api.minimaxi.com 或国际站地址。不要填写网页地址。"
      },
      "speech_model": {
        "description": "语音模型",
        "type": "string",
        "default": "speech-2.8-turbo"
      },
      "voice_id": {
        "description": "TTS 音色 ID",
        "type": "string",
        "default": "lovely_girl",
        "hint": "默认萌萌女童。可填账户已创建的克隆音色 ID；它不能作为 RVC 模型使用。"
      },
      "music_model": {
        "description": "歌曲生成模型",
        "type": "string",
        "default": "music-3.0"
      }
    }
  },
  "qwen": {
    "description": "千问语音 API",
    "type": "object",
    "items": {
      "api_key": {
        "description": "百炼 API Key",
        "type": "string",
        "secret": true,
        "default": "",
        "hint": "也可设置 DASHSCOPE_API_KEY。"
      },
      "base_url": {
        "description": "DashScope API 根地址",
        "type": "string",
        "default": "https://dashscope.aliyuncs.com/api/v1",
        "hint": "新加坡账户使用 https://dashscope-intl.aliyuncs.com/api/v1，Key 必须匹配地域。"
      },
      "model": {
        "description": "非实时 TTS 模型",
        "type": "string",
        "default": "qwen3-tts-flash"
      },
      "voice": {
        "description": "千问音色",
        "type": "string",
        "default": "Cherry"
      }
    }
  },
  "rvc": {
    "description": "云端 RVC 固定角色音色（Replicate）",
    "type": "object",
    "items": {
      "api_key": {
        "description": "Replicate API Token",
        "type": "string",
        "secret": true,
        "default": "",
        "hint": "也可设置 REPLICATE_API_TOKEN。"
      },
      "voice_model_url": {
        "description": "角色 RVC 模型 ZIP 公网直链",
        "type": "string",
        "default": "",
        "hint": "ZIP 内含 .pth，可选 .index；下载页面、MiniMax voice_id、SVC 模型不能直接替代。"
      },
      "version": {
        "description": "ultimate_rvc 模型版本 ID",
        "type": "string",
        "default": "c7a02f18043c32141e29fd5d10f91bb06f44ed0a7bc491817609ab9de41017e4",
        "hint": "固定版本保证参数一致，不能替换成参数不同的其他模型。"
      },
      "pitch": {
        "description": "升降调（半音，-24 至 24）",
        "type": "int",
        "default": 0
      },
      "index_rate": {
        "description": "音色索引强度（0 至 1）",
        "type": "float",
        "default": 0.3
      },
      "timeout_seconds": {
        "description": "云端转换最大等待秒数",
        "type": "int",
        "default": 900
      }
    }
  },
  "music": {
    "description": "歌曲发送与生成设置",
    "type": "object",
    "items": {
      "character_conversion": {
        "description": "生成新歌后转为同一角色音色",
        "type": "bool",
        "default": false
      },
      "delivery": {
        "description": "歌曲发送方式",
        "type": "string",
        "default": "file",
        "options": [
          "file",
          "record"
        ],
        "hint": "长歌曲推荐文件；QQ 官方接口不一定支持文件，按实际适配器选择。"
      },
      "timeout_seconds": {
        "description": "MiniMax 音乐请求超时秒数",
        "type": "int",
        "default": 600
      }
    }
  },
  "limits": {
    "description": "调用与缓存设置",
    "type": "object",
    "items": {
      "allowed_users": {
        "description": "允许使用的 QQ 号（空表示不限）",
        "type": "list",
        "default": []
      },
      "max_concurrent": {
        "description": "同时处理的任务上限",
        "type": "int",
        "default": 2
      },
      "cooldown_seconds": {
        "description": "每位用户的调用间隔秒数",
        "type": "int",
        "default": 1
      },
      "max_audio_mb": {
        "description": "下载音频大小上限 MB",
        "type": "int",
        "default": 40
      },
      "retention_hours": {
        "description": "音频缓存保留小时数",
        "type": "int",
        "default": 24
      }
    }
  }
}
